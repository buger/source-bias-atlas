_auto,q_auto/v1/posts/62d59c6cfacb808c5c4745a7c91a8332?_a=AQAEufR","num_upvotes":2,"num_comments":0,"created_at":"2023-11-15T10:06:30.460Z"},{"id":"TpEmBfo7J","title":"Kubernetes Best Practices","url":"https://blog.getambassador.io/kubernetes-best-practices-8527e74837a2?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/kubernetes-best-practices-tpembfo7j","summary":"This article provides Kubernetes best practices for configuration, including using the latest version of Kubernetes and implementing role-based access control (RBAC).","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/b7c881c74b527123f3c6eca7800c45fc?_a=AQAEufR","num_upvotes":2,"num_comments":0,"created_at":"2023-11-07T02:15:02.024Z"},{"id":"NIcOCVpjD","title":"Best Practices for Improving Resource Allocation in Kubernetes","url":"https://blog.getambassador.io/best-practices-for-improving-resource-allocation-in-kubernetes-70832e491341?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/best-practices-for-improving-resource-allocation-in-kubernetes-nicocvpjd","summary":"Optimizing resource allocation in Kubernetes is vital for balancing performance and cost while ensuring efficient resource use. This article discusses the challenges of optimizing resource allocation, best practices for improvement, and the role of monitoring and optimization tools.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/877820f1123d9b7ce937c2528ea49316?_a=AQAEufR","num_upvotes":0,"num_comments":0,"created_at":"2023-10-09T23:07:37.594Z"},{"id":"CniDFtjcd","title":"KubeCrash Fall 2023: Multi-cluster deployments at enterprise scale","url":"https://blog.getambassador.io/kubecrash-fall-2023-multi-cluster-deployments-at-enterprise-scale-f101065c4aa4?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/kubecrash-fall-2023-multi-cluster-deployments-at-enterprise-scale-cnidftjcd","summary":"KubeCrash Fall 2023 will focus on multi-cluster deployments at enterprise scale, covering topics such as network integration, cross-cluster communications, and avoiding misconfiguration-based app failure. A multi-cluster approach offers advantages such as improved application isolation, scalability, resilience, and resource management optimization. The conference will also support a non-profit initiative called Deaf Kids Code. KubeCrash is a one-day virtual conference hosted by six open source companies, providing crash courses on cloud native tech without vendor pitches. Open source has become critical to modern technology stacks and KubeCrash aims to help engineering teams leverage these technologies effectively. The conference will feature a program of keynotes, lighting talks, and sessions led by project maintainers.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/9db5c4bb07345d7d030f9a2c76a06c61?_a=AQAEufR","num_upvotes":0,"num_comments":0,"created_at":"2023-09-29T21:27:53.227Z"},{"id":"RicCFD04l","title":"Envoy Gateway 0.5.0 Release","url":"https://blog.getambassador.io/envoy-gateway-0-5-0-release-ccb4f1ca33e7?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/envoy-gateway-0-5-0-release-riccfd04l","summary":"This is the third article in our ongoing series on Envoy Gateway releases, covering the July 2023 release of v0.5.0. The next release of Kubernetes Gateway API will be v.6.0 with a theme of \u201cPreparation for GA\u201d","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/fd3bd93534837f561651148db5170812?_a=AQAEufR","num_upvotes":0,"num_comments":0,"created_at":"2023-09-22T17:21:18.047Z"},{"id":"Q1QFjJBN6","title":"Ambassador Edge Stack Web Application Firewall","url":"https://blog.getambassador.io/edge-stack-web-application-firewall-quickstart-33c19f3b9489?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/ambassador-edge-stack-web-application-firewall-q1qfjjbn6","summary":"Ambassador Labs provides a one-stop solution to open access to your application with strong auth controls and integrations, rate limiting, and now WAF protection. Ambassador Labs is here to help with our Ambassador Edge Stack API Gateway now with its own WAF functionality built in.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/a58698fbe24eae3e5d24c1c7fb568014?_a=AQAEufR","num_upvotes":0,"num_comments":0,"created_at":"2023-09-20T16:48:46.561Z"},{"id":"BWJIpDsyC","title":"How Your Culture Influences Developer Team Collaboration","url":"https://blog.getambassador.io/how-your-culture-influences-developer-team-collaboration-e06267c0bc2a?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/how-your-culture-influences-developer-team-collaboration-bwjipdsyc","summary":"A story hit #1 on Hacker News a few weeks ago titled \u2018The Worst Programmer I Know\u2019 The story\u2019s protagonist, Tim, never scored any story points. The Collective Power of a High-functioning Developer Team Individual brilliance is not enough in the world of software development.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/d4e8a91eabc60d5842e3095d43cf8561?_a=AQAEufR","num_upvotes":0,"num_comments":0,"created_at":"2023-09-19T17:35:51.812Z"},{"id":"Jdax08Gyc","title":"Ambassador Labs to Sponsor DevOpsDays Madrid 2023","url":"https://blog.getambassador.io/ambassador-labs-to-sponsor-devopsdays-madrid-2023-76d225d93cd2?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/ambassador-labs-to-sponsor-devopsdays-madrid-2023-jdax08gyc","summary":"Ambassador Labs to Sponsor DevOpsDays Madrid 2023. The Madrid event will welcome 500+ developers and other tech professionals to the CEU San Pablo Monteprincipe University campus. The event features a full-day roster with 4 speaking tracks in both Spanish and English.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/832990a404a3785e327e17e4c30f2211?_a=AQAEufR","num_upvotes":0,"num_comments":0,"created_at":"2023-09-18T20:35:18.575Z"},{"id":"nY7xmeukB","title":"Implementing and Debugging Load Tests for Go Applications Running in Kubernetes","url":"https://blog.getambassador.io/implementing-and-debugging-load-tests-for-go-applications-running-in-kubernetes-cf1030d12051?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/implementing-and-debugging-load-tests-for-go-applications-running-in-kubernetes-ny7xmeukb","summary":"Implementing and Debugging Load Tests for a Go Application Running in Kubernetes can be tricky. To ensure that your application can handle an expected user load, load testing must be executed before releasing the application. With k6, you can implement the test for different types of backend services, such as REST APIs, GraphQL APIs, gRPC services, and web sockets.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/b60424b0fced068202390cc94fbbef56?_a=AQAEufR","num_upvotes":0,"num_comments":0,"created_at":"2023-09-06T22:21:07.125Z"},{"id":"jihKaMVpw","title":"Ambassador Labs Community Advocates Program Celebrates Year 3","url":"https://blog.getambassador.io/ambassador-labs-community-advocates-program-celebrates-year-3-85de4f52c70f?source=rss----d7057b3b0cdd---4","comments_permalink":"https://app.daily.dev/posts/ambassador-labs-community-advocates-program-celebrates-year-3-jihkamvpw","summary":"Ambassador Labs community has well over 9,000 members in our OSS Slack channel alone and continues to grow! Ambassador Community Advocates help users of Emissary, Edge Stack, and Telepresence technologies adopt and apply them to a wide variety of environments and use cases.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/6d613a21b5f2d25ebbc0d6ccd2b8dced?_a=AQAEufR","num_upvotes":0,"num_comments":0,"created_at":"2023-09-06T11:50:33.959Z"}],"similar_handles":["bignerdranch","thatdot","fgiesen","tai","lambda"],"opposite_handles":[