{"version":"1","id":"asaprogrammer","handle":"asaprogrammer","name":"As a Programmer","image":"https://media.daily.dev/image/upload/s--Yj15Yt3x--/f_auto/v1736752915/logos/asaprogrammer","description":null,"is_squad":false,"x":-8.4285,"y":-8.5977,"cluster_id":1,"posts_collected":65,"newest_post_at":"2026-05-01T14:17:45.000Z","oldest_post_at":"2023-04-01T23:13:35.000Z","features":{"hype_score":0.015385,"listicle_ratio":0.030769,"question_ratio":0.0,"avg_read_time":339.215385,"summary_length_avg":462.222222,"title_length_avg":68.215385,"title_length_var":233.768994,"tag_entropy":2.986733,"tag_diversity":0.584615,"top_tag_share":0.461538,"avg_upvotes":42.830769,"median_upvotes":1.0,"avg_comments":0.892308,"comment_to_upvote_ratio":0.021185,"zero_engagement_share":0.369231,"viral_share":0.169231,"posts_per_week":0.961332,"non_article_ratio":1.0,"author_present_share":0.0,"recency_skew":0.083333},"view_coords":{"engagement_style":[9.5882,-2.7206],"cadence_depth":[-2.7059,9.9853],"hype_variety":[3.4853,-2.2353],"title_style":[-9.4706,6.75]},"top_tags":[["webdev",31],["react",28],["nodejs",14],["nextjs",12],["javascript",11],["typescript",9],["react-native",9],["mongodb",7]],"sample_titles":{"representative":["Python Full Course for Beginners (2025) - Build 35 Projects","Create an AI Fitness Assistant with Next.js","Next.js Tutorial 2025 - Build a Full Stack Social App with React & Next.js"],"outlier":["My plans for 2024 and channel goals..."]},"recent_posts":[{"id":"kDk1HZHiU","title":"PERN Stack Project: Build and Deploy a Full Stack E-Commerce App","url":"https://www.youtube.com/watch?v=sAH3rwO2H2o","comments_permalink":"https://app.daily.dev/posts/pern-stack-project-build-and-deploy-a-full-stack-e-commerce-app-kdk1hzhiu","summary":null,"image":"https://i.ytimg.com/vi/sAH3rwO2H2o/sddefault.jpg","num_upvotes":53,"num_comments":3,"created_at":"2026-05-01T14:17:45.000Z"},{"id":"tflAMo6LE","title":"Build a full-stack AI image generation SaaS with Next.js 16","url":"https://www.youtube.com/watch?v=7CPHXZN92Iw","comments_permalink":"https://app.daily.dev/posts/build-and-deploy-an-ai-saas-with-next-js-16---full-course-for-free-tflamo6le","summary":"A full-course walkthrough for building and deploying an AI image generation SaaS app using Next.js 16. Covers the complete stack including authentication with Clerk, payments, PostgreSQL database via Neon, file storage with ImageKit, error monitoring with Sentry, and UI with shadcn/ui and Tailwind CSS. The course demonstrates an AI-assisted development workflow using Cline (an open-source AI coding agent) to generate UI components, set up middleware, and scaffold features. Intended for intermediate-to-advanced developers who want to ship a monetizable product.","image":"https://i.ytimg.com/vi/7CPHXZN92Iw/sddefault.jpg","num_upvotes":16,"num_comments":1,"created_at":"2026-03-30T13:18:46.000Z"},{"id":"YrFGD8LDs","title":"Full Stack React Native Tutorial for Beginners in 2026","url":"https://www.youtube.com/watch?v=TuwcMlYAJlA","comments_permalink":"https://app.daily.dev/posts/full-stack-react-native-tutorial-for-beginners-in-2026-yrfgd8lds","summary":"A beginner-friendly full-stack mobile app tutorial using React Native and Expo. Covers building a grocery list app with four screens (authentication, list, planner, insights) that runs on both iOS and Android. The tech stack includes PostgreSQL with Drizzle ORM on Neon, Clerk for authentication (Google, Apple, GitHub OAuth), NativeWind (Tailwind CSS for React Native), and Zustand for state management. Topics covered include project setup with Expo CLI, file-based routing, React vs React Native component differences, NativeWind configuration, Clerk authentication integration with pre-built UI components, development builds, and GitHub deployment.","image":"https://i.ytimg.com/vi/TuwcMlYAJlA/sddefault.jpg","num_upvotes":62,"num_comments":2,"created_at":"2026-03-15T11:35:17.000Z"},{"id":"88gIMqxLb","title":"React Native Video Calling App Tutorial 2026","url":"https://www.youtube.com/watch?v=g5qHEi9M1rw","comments_permalink":"https://app.daily.dev/posts/react-native-video-calling-app-tutorial-2026-88gimqxlb","summary":"A comprehensive tutorial for building a full-featured video calling study app using React Native and Expo SDK 55. Covers project setup from scratch, NativeWind (Tailwind for React Native) integration, authentication with Clerk (Google, Apple, GitHub), real-time chat and video calls via Stream, and error monitoring with Sentry. Also includes a detailed breakdown of Expo SDK 55 changes: removal of legacy architecture, native tabs as default, faster OTA updates via bytecode diffing, new native UI features, and iOS widgets in alpha. All tools used offer free tiers, no credit card required.","image":"https://i.ytimg.com/vi/g5qHEi9M1rw/sddefault.jpg","num_upvotes":10,"num_comments":0,"created_at":"2026-02-27T14:30:24.000Z"},{"id":"6RkkQLbCE","title":"100 HTML CSS JavaScript projects for beginners","url":"https://www.youtube.com/watch?v=bW58B6y81y8","comments_permalink":"https://app.daily.dev/posts/100-html-css-javascript-projects-for-beginners-in-2026-6rkkqlbce","summary":"A hands-on course offering 100 beginner-friendly web development projects built with HTML, CSS, and JavaScript. Projects include e-commerce shopping carts, QR code generators, UI components like pricing cards and contact forms, and interactive features like quiz games and color palette generators. Each project is taught step-by-step with complete code walkthroughs, workspace setup guidance, and responsive design implementation.","image":"https://i.ytimg.com/vi/bW58B6y81y8/sddefault.jpg","num_upvotes":61,"num_comments":1,"created_at":"2026-02-06T07:00:25.000Z"},{"id":"zjgS3iANN","title":"Full Stack Mobile Development Course: Build a Realtime Mobile App with React Native","url":"https://www.youtube.com/watch?v=ufo46oWej3g","comments_permalink":"https://app.daily.dev/posts/full-stack-mobile-development-course-build-a-realtime-mobile-app-with-react-native-zjgs3iann","summary":null,"image":"https://i.ytimg.com/vi/ufo46oWej3g/sddefault.jpg","num_upvotes":2,"num_comments":0,"created_at":"2026-01-15T16:17:29.000Z"},{"id":"avWCmYSRb","title":"PERN Stack Course: Build a Full Stack Product Store with React and Postgres","url":"https://www.youtube.com/watch?v=y7kvxIQQxtQ","comments_permalink":"https://app.daily.dev/posts/pern-stack-course-build-a-full-stack-product-store-with-react-and-postgres-avwcmysrb","summary":"A comprehensive tutorial for building a full-stack product store application using the PERN stack (PostgreSQL, Express, React, Node.js). The course covers backend API development with TypeScript, Drizzle ORM for database management, authentication with Clerk, and frontend development with React, Tailwind CSS, and TanStack Query. Includes complete setup instructions, database schema design with relations, environment configuration, and deployment guidance. Features user authentication, product CRUD operations, commenting system, and 30+ theme options with responsive design.","image":"https://i.ytimg.com/vi/y7kvxIQQxtQ/sddefault.jpg","num_upvotes":48,"num_comments":3,"created_at":"2025-12-30T15:26:31.000Z"},{"id":"rauBoq6xI","title":"The Ultimate E-Commerce App with React Native | Build Your Own Mobile App","url":"https://www.youtube.com/watch?v=m1f5qkFDZnk","comments_permalink":"https://app.daily.dev/posts/the-ultimate-e-commerce-app-with-react-native-build-your-own-mobile-app-rauboq6xi","summary":null,"image":"https://i.ytimg.com/vi/m1f5qkFDZnk/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2025-12-14T14:41:41.000Z"},{"id":"GZKNcHD7N","title":"Build a Massive E-Commerce Store with React Native","url":"https://www.youtube.com/watch?v=FaXe__AxzNU","comments_permalink":"https://app.daily.dev/posts/build-a-massive-e-commerce-store-with-react-native-gzknchd7n","summary":null,"image":"https://i.ytimg.com/vi/FaXe__AxzNU/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2025-11-30T12:09:25.000Z"},{"id":"gdqEdizxK","title":"MERN Stack Project: Video Calling Interview Platform with React & Node.js","url":"https://www.youtube.com/watch?v=PJ0ARnSKfgw","comments_permalink":"https://app.daily.dev/posts/mern-stack-project-video-calling-interview-platform-with-react-node-js-gdqedizxk","summary":"Build a complete interview platform featuring video calling, real-time chat, and a code editor supporting JavaScript, Python, and Java. The platform includes session management, screen sharing, message reactions, and code execution in isolated environments. Uses the MERN stack (MongoDB, Express, React, Node.js) with additional tools like Tailwind CSS, Clerk for authentication, Stream for video/chat, and deployment on Savala. Covers proper Git workflow with branches and pull requests, code reviews with Code Rabbit AI, and production deployment configuration including serving both API and React app from a single domain.","image":"https://i.ytimg.com/vi/PJ0ARnSKfgw/sddefault.jpg","num_upvotes":20,"num_comments":0,"created_at":"2025-10-31T12:08:50.000Z"}],"similar_handles":["philipplackner","developedbyed","networkchuck","lowlevellearning","kevinpowell"],"opposite_handles":["alexfinn","tbpn","kloss_xyz","ryolu_","patrickc"],"similar":[{"id":"philipplackner","handle":"philipplackner","name":"Philipp Lackner","is_squad":false,"x":-8.4119,"y":-8.4794,"cluster_id":1,"posts_collected":243,"image":"https://media.daily.dev/image/upload/s--WOEWUbRT--/f_auto/v1725038407/logos/philipplackner","features_preview":{"posts_per_week":2.771502,"median_upvotes":1.0,"author_present_share":0.0,"hype_score":0.024691,"avg_read_time":20.798354,"tag_diversity":0.374486},"top_tags_preview":[["android",153],["kotlin",128],["jetpack-compose",66]],"view_coords":{"engagement_style":[5.1176,3.2647],"cadence_depth":[3.8529,8.7941],"hype_variety":[5.7941,0.6324],"title_style":[6.8088,3.7059]}},{"id":"developedbyed","handle":"developedbyed","name":"developedbyed","is_squad":false,"x":-8.5771