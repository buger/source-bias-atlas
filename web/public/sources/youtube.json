0Z"},{"id":"NAHuagGm9","title":"How to build a web dashboard from Excel data using Claude AI","url":"https://www.youtube.com/watch?v=uK_WOYjtRKo","comments_permalink":"https://app.daily.dev/posts/create-a-professional-dashboard-with-one-prompt-using-claude-ai-in-just-3-minutes--nahuaggm9","summary":"A walkthrough showing how to convert Excel sales data into a web dashboard using Claude AI with a single prompt. The process involves exporting Excel data to CSV, converting it to JSON using an online tool, then pasting the JSON and a prompt into Claude AI to generate an HTML-based dashboard with charts and key metrics. Also covers how to generate a prompt by uploading a dashboard screenshot to Claude AI.","image":"https://i.ytimg.com/vi/uK_WOYjtRKo/sddefault.jpg","num_upvotes":2,"num_comments":0,"created_at":"2026-05-01T10:30:39.000Z"},{"id":"fu9tR7C55","title":"Introducing Cloud Computer for Manus | Build Bots, Databases & 24/7 Automations Without Code","url":"https://www.youtube.com/watch?v=W-7_PW1_Vws","comments_permalink":"https://app.daily.dev/posts/introducing-cloud-computer-for-manus-build-bots-databases-24-7-automations-without-code-fu9tr7c55","summary":"No meaningful technical content could be extracted from this post. The content appears to be song lyrics or audio transcript with no substantive information about Cloud Computer, Manus, bots, databases, or automations.","image":"https://i.ytimg.com/vi/W-7_PW1_Vws/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-04-30T15:30:16.000Z"},{"id":"ys6OWf1Go","title":"Real-time data, zero overhead: Stripe Database + next generation of Stripe Data Pipeline","url":"https://www.youtube.com/watch?v=mWVbWOalhSE","comments_permalink":"https://app.daily.dev/posts/real-time-data-zero-overhead-stripe-database-next-generation-of-stripe-data-pipeline-ys6owf1go","summary":"Stripe has announced two new products: Stripe Database and a next-generation Stripe Data Pipeline. Stripe Database is a managed Postgres database that automatically syncs all of a merchant's Stripe API data in real time (sub-1-second latency), providing a connection string developers can use directly in their apps without managing infrastructure. The next-gen Data Pipeline currently supports syncing to Google Sheets in real time via webhooks, with plans to add destinations like Snowflake and external Postgres databases. The project originated from an open-source Supabase integration that Stripe collaborated on and extended. Both products target the same core problem \u2014 getting Stripe data into the right place instantly \u2014 with the key difference being whether developers want Stripe to manage the database or pipe data into their own destination.","image":"https://i.ytimg.com/vi/mWVbWOalhSE/sddefault.jpg","num_upvotes":4,"num_comments":0,"created_at":"2026-04-30T15:17:05.000Z"}],"similar_handles":["portalrunner","howardjeremyp","aarondfrancis","goto","joshtriedcoding"],"opposite_handles":["horde","dailydevworld","watercooler","on_leuwcq","devtools"],"similar":[{"id":"portalrunner","handle":"portalrunner","name":"PortalRunner","is_squad":false,"x":-4.7303,"y":-10.1143,"cluster_id":3,"posts_collected":54,"image":"https://media.daily.dev/image/upload/s--aSL1WXXp--/f_auto/v1756381503/logos/portalrunner","features_preview":{"posts_per_week":1.503921,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.0,"avg_read_time":52.981481,"tag_diversity":0.351852},"top_tags_preview":[["hardware",2],["signal-processing",2],["javascript",2]],"view_coords":{"engagement_style":[2.5735,8.4265],"cadence_depth":[-4.0,9.7353],"hype_variety":[-5.7941,-3.2206],"title_style":[7.7353,-3.2794]}},{"id":"howardjeremyp","handle":"howardjeremyp","name":"Jeremy Howard","is_squad":false,"x":-4.6614,"y":-10.3811,"cluster_id":3,"posts_collected":62,"image":"https://media.daily.dev/image/upload/s--rqXYQTz2--/f_auto/v1724338874/logos/howardjeremyp","features_preview":{"posts_per_week":0.821683,"median_upvotes":0.0,"author_presen