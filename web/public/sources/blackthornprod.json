m_comments":0,"created_at":"2026-04-15T16:37:44.000Z"},{"id":"wA0lRU1T9","title":"The making of DON'T CHICKEN OUT - a multiplayer rage game","url":"https://www.youtube.com/watch?v=OvxOwzUuw0s","comments_permalink":"https://app.daily.dev/posts/the-making-of-don-t-chicken-out---a-multiplayer-rage-game-wa0lru1t9","summary":"A devlog about the development of 'Don't Chicken Out', a cooperative multiplayer rage game made by two brothers using Unity. The game features two chickens balancing an egg through increasingly difficult zones (farm, city, jungle, Himalayas, space). Key development highlights include the art style evolution from atmospheric silhouettes to bold cartoony visuals, the challenge of implementing online multiplayer using Photon Fusion, and the iterative process of prototyping multiple game concepts before settling on this one. A free demo is available on Steam.","image":"https://i.ytimg.com/vi/OvxOwzUuw0s/sddefault.jpg","num_upvotes":2,"num_comments":0,"created_at":"2026-04-14T14:58:39.000Z"},{"id":"wK7eiOwPl","title":"Don't Chicken Out is a new co-op indie game about balancing an egg","url":"https://www.youtube.com/watch?v=Euwr3pJdDu4","comments_permalink":"https://app.daily.dev/posts/this-might-be-the-hardest-indie-game-this-year--wk7eiowpl","summary":"Don't Chicken Out is a co-op indie game where two players control separate chickens carrying a shared basket with an egg balanced on it. Each player can only move their own chicken, and coordinating movements is essential to prevent the egg from rolling off. The game features a colorful obstacle course that demands tight communication and coordination between players.","image":"https://i.ytimg.com/vi/Euwr3pJdDu4/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-04-09T12:16:03.000Z"},{"id":"NkDA9gc3s","title":"Developer considers adding tiny basket hardcore mode to rage co-op game","url":"https://www.youtube.com/watch?v=6pi-_lZA5cQ","comments_permalink":"https://app.daily.dev/posts/should-we-make-our-game-even-harder--nkda9gc3s","summary":"A game developer is considering adding an extra difficulty mode ('tiny basket mode') to their rage co-op game 'Don't Chicken Out', where players balance an egg in a much smaller basket. The post asks the community for feedback on whether to include this hardcore challenge mode, and promotes the game's Steam wishlist page.","image":"https://i.ytimg.com/vi/6pi-_lZA5cQ/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-04-08T13:56:47.000Z"},{"id":"Z8c77BIY2","title":"Dev speedrun fantasy vs reality meme promoting a Steam game","url":"https://www.youtube.com/watch?v=L--U_OeBlNk","comments_permalink":"https://app.daily.dev/posts/dev-speedrun-vs-reality-z8c77biy2","summary":"A humorous post comparing the idealized 'speedrun' fantasy of game development against the frustrating reality, promoting a game called 'Don't Chicken Out' on Steam.","image":"https://i.ytimg.com/vi/L--U_OeBlNk/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-04-08T09:42:33.000Z"},{"id":"SVpzLiLHs","title":"Blackthornprod's NEXT Steam Game (2 weeks of indie game dev)","url":"https://www.youtube.com/watch?v=d0zpQn_wgno","comments_permalink":"https://app.daily.dev/posts/blackthornprod-s-next-steam-game-2-weeks-of-indie-game-dev--svpzlilhs","summary":"A devlog from Blackthornprod covering two weeks of indie game development, exploring two game prototypes. The first is a dark medieval medical simulator where players diagnose and treat patients with fantastical diseases, using tools like leeches and syringes while managing reputation. The second is a relaxing incremental market/farming game set in southern France, featuring plant symbiosis mechanics, life cycles, and upgrades. The post also includes a sketchbook tour showing anatomical studies and travel drawings from Istanbul, highlighting how real-world observation fuels game art and design.","image":"https://i.ytimg.com/vi/d0zpQn_wgno/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-02-21T11:12:57.000Z"},{"id":"FIK4M7oUO","title":"5 DEVS Make GTA 6 without COMMUNICATING!","url":"https://www.youtube.com/watch?v=1rTbcgkBsnk","comments_permalink":"https://app.daily.dev/posts/5-devs-make-gta-6-without-communicating--fik4m7ouo","summary":null,"image":"https://i.ytimg.com/vi/1rTbcgkBsnk/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-02-02T15:25:47.000Z"},{"id":"f8GETPOuX","title":"We made 9 VIDEO GAMES in 9 days!","url":"https://www.youtube.com/watch?v=ul6DbgKOk7k","comments_permalink":"https://app.daily.dev/posts/we-made-9-video-games-in-9-days--f8getpoux","summary":null,"image":"https://i.ytimg.com/vi/ul6DbgKOk7k/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-01-31T13:56:21.000Z"},{"id":"DghscvZbR","title":"BLACKTHORNPROD responds to criticism and announces 2026 plans","url":"https://www.youtube.com/watch?v=APgX25EJUd8","comments_permalink":"https://app.daily.dev/posts/what-is-next-for-blackthornprod-in-2026--dghscvzbr","summary":"BLACKTHORNPROD addresses recent criticism about their Game Dev Rocket course marketing and game development challenges. They apologize for misleading testimonials and unclear marketing claims, while defending their teaching credentials and challenge format. The channel plans to refocus on free YouTube tutorials, devlogs for their new game \"Cooking in Silence\", and Unity/C# educational content in 2026, offering a free beginner course to start.","image":"https://i.ytimg.com/vi/APgX25EJUd8/sddefault.jpg","num_upvotes":0,"num_comments":1,"created_at":"2026-01-05T13:04:18.000Z"},{"id":"7OaoqMQy8","title":"The Art of Blackthornprod (14 to 25 years old)","url":"https://www.youtube.com/watch?v=xLLYqCVGGZY","comments_permalink":"https://app.daily.dev/posts/the-art-of-blackthornprod-14-to-25-years-old--7oaoqmqy8","summary":"A personal journey through 11 years of art development, from early 3D modeling with Autodesk Maya at age 14 to traditional drawing after a stroke at 23. The creator shares their evolution from digital game art (2016-2022) to daily pencil practice, emphasizing consistent morning sessions, life drawing, and balancing observational work with imagination. Key projects include various indie games with distinct art styles, portrait studies, and watercolor fantasy illustrations inspired by Dungeons & Dragons.","image":"https://i.ytimg.com/vi/xLLYqCVGGZY/sddefault.jpg","num_upvotes":1,"num_comments":0,"created_at":"2025-12-22T10:19:50.000Z"}],"similar_handles":["prettier","codewithchris","liveoverflow","aisnakeoil","brevzin"],"opposite_handles":["alexfinn","tbpn","kloss_xyz","ryolu_","patrickc"],"similar":[{"id":"prettier","handle":"prettier","name":"Prettier","is_squad":false,"x":-7.5855,"y":-6.5437,"cluster_id":1,"posts_collected":34,"image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/6e590d6b7a8c42eaae95f3a4018e48d8","features_preview":{"posts_per_week":0.157961,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.264706,"avg_read_time":8.058824,"tag_diversity":0.5},"top_tags_preview":[["javascript",27],["typescript",23],["webdev",9]],"view_coords":{"engagement_style":[8.1912,-2.8971],"cadence_depth":[-6.1618,4.1618],"hype_variety":[9.9118,-8.2206],"title_style":[-5.8529,-3.2059]}},{"id":"codewithchris","handle":"codewithchris","name":"CodeWithChris","is_squad":false,"x":-7.45,"y":-6.5987,"cluster_id":1,"posts_collected":160,"image":"https://media.daily.dev/image/upload/s--GG06ZcGp--/f_auto/v1718349260/logos/codewithchris","features_preview":{"posts_per_week":1.622515,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.028125,"avg_read_time":15.55,"tag_diversity":0.2875},"top_tags_preview":[["ios",114],["swift",110],["xcode",100]],"view_coords":{"engagement_style":[-4.0441,4.3529],"cadence_depth":[1.8824,8.1176],"hype_variety":[6.4559,-6.9412],"title_style":[3.3971,6.8382]}},{"id":"liveoverflow","handle":"liveoverflow","name":"LiveOverflow","is_squad":false,"x":-7.58