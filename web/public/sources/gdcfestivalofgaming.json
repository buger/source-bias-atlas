{"version":"1","id":"gdcfestivalofgaming","handle":"gdcfestivalofgaming","name":"GDC Festival of Gaming","image":"https://media.daily.dev/image/upload/s--EatFrQY---/f_auto,q_auto/v1773656431/logos/gdcfestivalofgaming?_a=BAMAMiiu0","description":null,"is_squad":false,"x":-2.2017,"y":-7.8932,"cluster_id":1,"posts_collected":56,"newest_post_at":"2026-05-07T16:00:48.000Z","oldest_post_at":"2025-03-20T04:11:19.000Z","features":{"hype_score":0.017857,"listicle_ratio":0.089286,"question_ratio":0.0,"avg_read_time":16.053571,"summary_length_avg":509.1875,"title_length_avg":54.142857,"title_length_var":336.943878,"tag_entropy":1.865991,"tag_diversity":0.214286,"top_tag_share":0.214286,"avg_upvotes":0.0,"median_upvotes":0.0,"avg_comments":0.0,"comment_to_upvote_ratio":1.0,"zero_engagement_share":1.0,"viral_share":0.0,"posts_per_week":7.50353,"non_article_ratio":1.0,"author_present_share":0.0,"recency_skew":56.0},"view_coords":{"engagement_style":[-9.9412,-7.3971],"cadence_depth":[-3.8088,8.2206],"hype_variety":[4.2353,-9.2647],"title_style":[-9.6618,9.2941]},"top_tags":[["game-development",14],["game-design",8],["gaming",4],["testing",1],["unreal-engine",1],["accessibility",1],["ux",1],["unity",1]],"sample_titles":{"representative":["26th Annual Game Developers Choice Awards","Reimagining High Fantasy: The Score to 'Eternal Strands'","'Avowed' Branching Narratives: Shifting from QA Testing to Analyzing Clip - #GDCrewind #GDC2025"],"outlier":["Dynamic Environment Lighting in Sky: Children of the Light             #gdcrewind  #gdc2026 #gaming"]},"recent_posts":[{"id":"Txbwv2Jue","title":"Reimagining High Fantasy: The Score to 'Eternal Strands'","url":"https://www.youtube.com/watch?v=d4C2fb6yi-s","comments_permalink":"https://app.daily.dev/posts/reimagining-high-fantasy-the-score-to-eternal-strands--txbwv2jue","summary":null,"image":"https://i.ytimg.com/vi/d4C2fb6yi-s/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-05-01T17:00:52.000Z"},{"id":"k5snSYrRe","title":"Embracing Neurodiversity and Leadership in the Game Industry","url":"https://www.youtube.com/watch?v=vRehu7ke_EE","comments_permalink":"https://app.daily.dev/posts/embracing-neurodiversity-and-leadership-in-the-game-industry-k5snsyrre","summary":null,"image":"https://i.ytimg.com/vi/vRehu7ke_EE/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-04-28T16:00:54.000Z"},{"id":"pgxzYCaeK","title":"'Avowed' Branching Narratives: Shifting from QA Testing to Analyzing Clip - #GDCrewind #GDC2025","url":"https://www.youtube.com/watch?v=Y2mn_kcT47w","comments_permalink":"https://app.daily.dev/posts/avowed-branching-narratives-shifting-from-qa-testing-to-analyzing-clip---gdcrewind-gdc2025-pgxzycaek","summary":"A GDC 2025 talk excerpt covering how the QA team on Avowed shifted from traditional black-box testing to analyzing game logic and scripting directly. The session demonstrates how QA testers work alongside developers to review Unreal Engine Blueprint scripting conditions, understand intended NPC behavior, and identify bugs by comparing expected versus actual logic \u2014 rather than only observing runtime outcomes.","image":"https://i.ytimg.com/vi/Y2mn_kcT47w/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-04-21T16:00:56.000Z"},{"id":"GUQk4e6mG","title":"Crowdfunding Best Practices - #GDCRewind #GDC2025","url":"https://www.youtube.com/watch?v=_09SrR5y9tw","comments_permalink":"https://app.daily.dev/posts/crowdfunding-best-practices---gdcrewind-gdc2025-guqk4e6mg","summary":"Crowdfunding campaign metrics for game developers: roughly 10-12% of pre-launch followers convert to backers in the first 24 hours, rising to 18-20% by campaign end. This conversion rate allows creators to back-calculate how many followers they need before launching to hit their funding goals, assuming roughly half of backers come from existing followers.","image":"https://i.ytimg.com/vi/_09SrR5y9tw/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-04-17T18:01:00.000Z"},{"id":"x17Q3oJlT","title":"2026 Developer's Concert - GDC Festival of Gaming","url":"https://www.youtube.com/watch?v=CfC5h3Hj7tc","comments_permalink":"https://app.daily.dev/posts/2026-developer-s-concert---gdc-festival-of-gaming-x17q3ojlt","summary":null,"image":"https://i.ytimg.com/vi/CfC5h3Hj7tc/hqdefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-03-23T15:00:18.000Z"},{"id":"maSEkdCCX","title":"26th Annual Game Developers Choice Awards","url":"https://www.youtube.com/watch?v=b7gjPzpin8k","comments_permalink":"https://app.daily.dev/posts/26th-annual-game-developers-choice-awards-masekdccx","summary":"Transcript of the 26th Annual Game Developers Choice Awards ceremony held at GDC 2026. Claire Obscure: Expedition 33 by Sandfall Interactive dominated the night, winning Game of the Year, Best Debut, Best Visual Art, Best Narrative, and Best Audio. Blue Prince won Best Design and Best Innovation. Death Stranding 2 took Best Technology. The ceremony featured commentary on industry layoffs, studio closures, AI in games, and the importance of indie games. Don Daglo received the Lifetime Achievement Award for 55 years of pioneering game design. The show also touched on themes of creative passion amid industry turbulence.","image":"https://i.ytimg.com/vi/b7gjPzpin8k/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-03-13T15:20:25.000Z"},{"id":"SyfvLJtbS","title":"GDC 2026 Keynote - An Odyssey in Building Games That Last","url":"https://www.youtube.com/watch?v=XxvLyd4lKZM","comments_permalink":"https://app.daily.dev/posts/gdc-2026-keynote---an-odyssey-in-building-games-that-last-syfvljtbs","summary":"Rob Pardo, former Blizzard veteran and CEO of Bonfire Studios, delivers a GDC 2026 keynote reflecting on 25+ years of building enduring games. He shares lessons from Starcraft, Warcraft 3, World of Warcraft, Hearthstone, and the cancelled Project Titan. Key insights include: the importance of building the right team before pitching a game concept, finding the 'minimum lovable game' by prototyping core loops first, using daily playtests as a development ritual, and recognizing the milestone when a team falls in love with their own game. He also details Bonfire Studios' decade-long journey developing Archeron (formerly Colt/Dungeon Royale), a PvP dungeon-crawling extraction game. Pardo argues that 'forever games' cannot be engineered by formula \u2014 they emerge from authentic team passion, iterative discovery, and ultimately player adoption.","image":"https://i.ytimg.com/vi/XxvLyd4lKZM/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-03-13T05:07:32.000Z"},{"id":"PgTZXOaD5","title":"2026 Independent Games Festival Awards","url":"https://www.youtube.com/watch?v=NoH4EmfB4Z4","comments_permalink":"https://app.daily.dev/posts/2026-independent-games-festival-awards-pgtzxoad5","summary":"The 2026 Independent Games Festival (IGF) Awards ceremony transcript covers the full event held at GDC, including opening remarks, award presentations, winner speeches, and closing thoughts. Awards presented include Best Student Game (Poco), Excellence in Design (Titanium Court), Alt Control GDC (Procto), Excellence in Visual Art (Eclipsium), Excellence in Audio (Baby Steps), Audience Award (Wednesdays), Wings Award (13Z: The Zodiac Trials), Excellence in Narrative (Perfect Tides: Station to Station), Novo Award (Horses), and the Sheamus McNal Grand Prize (Titanium Court). The ceremony featured commentary on the state of the indie game industry, layoffs, funding challenges, diversity, and political climate affecting developers' ability to attend.","image":"https://i.ytimg.com/vi/NoH4EmfB4Z4/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-03-12T03:32:50.000Z"},{"id":"ZmsqcWr9U","title":"GDCA 2026 Host Announcement - Sam Maggs","url":"https://www.youtube.com/watch?v=rPeeaqA2St0","comments_permalink":"https://app.daily.dev/posts/gdca-2026-host-announcement---sam-maggs-zmsqcwr9u","summary":"Sam Maggs announces she will return as host for the 2026 Game Developers Choice Awards, taking place on March 12th at 6:30 p.m. Pacific, live from San Francisco and streamed on GDC online channels. The ceremony will celebrate the best games of 2025.","image":"https://i.ytimg.com/vi/rPeeaqA2St0/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-02-19T19:30:16.000Z"},{"id":"6braUTaBf","title":"2026 IGF Karrie Shao Host Announcement","url":"https://www.youtube.com/watch?v=_qqGXjNI-_Y","comments_permalink":"https://app.daily.dev/posts/2026-igf-karrie-shao-host-announcement-6brautabf","summary":null,"image":"https://i.ytimg.com/vi/_qqGXjNI-_Y/sddefault.jpg","num_upvotes":0,"num_comments":0,"created_at":"2026-02-18T19:05:52.000Z"}],"top_posts":[],"similar_handles":["jbhuang0604","stevdzasan","coffee-software","watchtowr-labs","codewithbeto"],"opposite_handles":["horde","dailydevworld","watercooler","on_leuwcq","dotnetsquad"],"similar":[{"id":"jbhuang0604","handle":"jbhuang0604","name":"Jia-Bin Huang","is_squad":false,"x":-2.0482,"y":-7.9956,"cluster_id":3,"posts_collected":47,"image":"https://media.daily.dev/image/upload/s--8hwFrfWM--/f_auto,q_auto/v1776585907/logos/jbhuang0604","features_preview":{"posts_per_week":21.479692,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.010638,"avg_read_time":10.978723,"tag_diversity":0.574468},"top_tags_preview":[["computer-vision",17],["diffusion-models",13],["deep-learning",11]],"view_coords":{"engagement_style":[-8.9559,-6.8529],"cadence_depth":[-4.6618,6.9559],"hype_variety":[1.6324,-3.4118],"title_style":[1.2647,-0.2941]}},{"id":"stevdzasan","handle":"stevdzasan","name":"Stevdza-San","is_squad":false,"x":-2.239,"y":-8.1512,"cluster_id":3,"posts_collected":15,"image":"https://media.daily.dev/image/upload/s--IthzHSnd--/f_auto,q_auto/v1774179041/logos/stevdzasan?_a=BAMAMiWQ0","features_preview":{"posts_per_week":2.374199,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.0,"avg_