-natu-tk9vdqbux","summary":"Sourcegraph has released a new feature called Query Assist, which allows developers to search code using natural language instead of writing explicit search queries. This is part of a broader set of updates to the Sourcegraph platform.","image":"https://media.daily.dev/image/upload/s--ZrL_HSsR--/f_auto/v1722860399/public/Placeholder%2006","num_upvotes":0,"num_comments":0,"created_at":"2026-04-01T19:53:33.000Z"},{"id":"3SM1gBIIB","title":"It's week 1 of our new Use Case of the Week series! \n\nThis week we're talking about Code Reuse\n\nSourcegraph's Deep Search product can show you patterns and implementations for specific jobs that your team has already proven\n\nThen you can reuse that code instead of duplicating work! \n\nLearn more about this and other use cases on our new use case page:","url":"https://x.com/sourcegraph/status/2039028190782648701","comments_permalink":"https://app.daily.dev/posts/it-s-week-1-of-our-new-use-case-of-the-week-series-this-week-we-re-talking-about-code-reuse-sour-3sm1gbiib","summary":"Sourcegraph's Deep Search product enables code reuse by surfacing existing patterns and implementations from your team's codebase, helping developers avoid duplicating work. A new use case page highlights this and other workflows.","image":"https://media.daily.dev/image/upload/s--CxzD6vbw--/f_auto/v1722860399/public/Placeholder%2005","num_upvotes":0,"num_comments":0,"created_at":"2026-03-31T17:12:58.000Z"}],"similar_handles":["nickscamara_","baconbrix","cognition","xai","koenbok"],"opposite_handles":["on_leuwcq","dailydevworld","ergq3auoe","horde","webcraft"],"similar":[{"id":"nickscamara_","handle":"nickscamara_","name":"Nicolas Camara","is_squad":false,"x":9.7397,"y":-1.6622,"cluster_id":0,"posts_collected":36,"image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/e526ef4a503c498a979a50ec580819aa","features_preview":{"posts_per_week":3.555142,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.0555