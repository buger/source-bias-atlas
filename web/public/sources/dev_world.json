{"version":"1","id":"81a3df5b-e17a-41f0-ae4f-8035927c6518","handle":"dev_world","name":"Dev World","image":"https://media.daily.dev/image/upload/s--qM3M5FZK--/f_auto/v1727083541/squads/81a3df5b-e17a-41f0-ae4f-8035927c6518","description":null,"is_squad":true,"x":-8.3798,"y":9.9969,"cluster_id":2,"posts_collected":29,"newest_post_at":"2026-04-29T09:42:14.450Z","oldest_post_at":"2025-01-04T15:19:46.954Z","features":{"hype_score":0.037037,"listicle_ratio":0.0,"question_ratio":0.037037,"avg_read_time":2.222222,"summary_length_avg":457.740741,"title_length_avg":57.407407,"title_length_var":346.315501,"tag_entropy":3.819681,"tag_diversity":1.965517,"top_tag_share":0.172414,"avg_upvotes":136.275862,"median_upvotes":4.0,"avg_comments":9.448276,"comment_to_upvote_ratio":0.069567,"zero_engagement_share":0.0,"viral_share":0.034483,"posts_per_week":0.423123,"non_article_ratio":1.0,"author_present_share":1.0,"recency_skew":0.45},"view_coords":{"engagement_style":[9.9559,6.5441],"cadence_depth":[-6.8529,-7.3529],"hype_variety":[7.4118,6.2059],"title_style":[4.2353,-7.6912]},"top_tags":[["webdev",7],["ai",6],["open-source",5],["career",5],["devtools",4],["security",4],["javascript",3],["frontend",2]],"sample_titles":{"representative":["\ud83d\ude80 Frontend Designers & Developers, Meet Your New Best Friend! \ud83c\udfa8\ud83d\udcbb","Forget the Rules: Build a Developer Portfolio That\u2019s Unapologetically Yours"],"outlier":["Mockup Generator App"]},"recent_posts":[{"id":"WS1s9L9Jw","title":"How Bifrost MCP Gateway Cuts LLM Costs by 90% (Access Control, Tool Governance & Code Mode)","url":"","comments_permalink":"https://app.daily.dev/posts/how-bifrost-mcp-gateway-cuts-llm-costs-by-90-access-control-tool-governance-code-mode--ws1s9l9jw","summary":"Bifrost MCP Gateway is an open-source AI gateway that addresses the scaling problems of MCP setups: token cost explosion from injecting all tools into context, lack of access control, and fragmented cost visibility. It sits between agents, LLM providers, and MCP servers as a single control plane. Key features include virtual key-based access control with per-tool permissions, centralized observability for every tool call, and 'Code Mode' \u2014 which exposes MCP tools as Python stubs and executes them on-demand in a sandbox rather than loading all tools into context. Benchmarks show up to 92% reduction in input tokens and 40% faster execution with Code Mode enabled.","image":"https://media.daily.dev/image/upload/s--ecZfVt-r--/f_auto/v1777455740/posts/WS1s9L9Jw?_a=BAMAMiWQ0","num_upvotes":4,"num_comments":2,"created_at":"2026-04-29T09:42:14.450Z"},{"id":"xJXYqkm5r","title":null,"url":"","comments_permalink":"https://app.daily.dev/posts/xjxyqkm5r","summary":null,"image":"https://media.daily.dev/image/upload/s--foaA6JGU--/f_auto/v1722860399/public/Placeholder%2004","num_upvotes":98,"num_comments":15,"created_at":"2026-04-28T03:52:03.428Z"},{"id":"OXCc1F574","title":null,"url":"","comments_permalink":"https://app.daily.dev/posts/oxcc1f574","summary":null,"image":"https://media.daily.dev/image/upload/s--2-1xRawN--/f_auto/v1722860399/public/Placeholder%2011","num_upvotes":45,"num_comments":12,"created_at":"2026-04-27T09:59:22.914Z"},{"id":"V3FHM8TdL","title":"A Minimalist Tool to create mockups and demonstrations","url":"","comments_permalink":"https://app.daily.dev/posts/a-minimalist-tool-to-create-mockups-and-demonstrations-v3fhm8tdl","summary":"OpenVid is a browser-based open source tool for creating professional mockups and demos. It supports mask image effects, 3D effects, and other visual enhancements without requiring any local installation.","image":"https://media.daily.dev/image/upload/s--LHWz5KCa--/f_auto/v1776965911/posts/jsYKkcj6N?_a=BAMAMiWQ0","num_upvotes":7,"num_comments":0,"created_at":"2026-04-23T18:55:39.668Z"},{"id":"E9PNA46PZ","title":"OpenVid: The Open-Source Studio to Create Cinematic Demos in Your Browser","url":"","comments_permalink":"https://app.daily.dev/posts/openvid-the-open-source-studio-to-create-cinematic-demos-in-your-browser-e9pna46pz","summary":"OpenVid is a browser-based, open-source video editor designed for developers and makers who need to create professional product demos quickly. It requires no installation and has no complex timeline, running entirely in the browser for fast, cinematic results. The project is available on GitHub and can be tried at openvid.dev.","image":"https://media.daily.dev/image/upload/s--AvEUzpPI--/f_auto/v1776256407/posts/3rj1PfINd?_a=BAMAMiWQ0","num_upvotes":94,"num_comments":18,"created_at":"2026-04-15T12:37:24.161Z"},{"id":"aXqtXt6TN","title":"Why VS Code Is Still My Go-To IDE (After Trying Everything Else)","url":"","comments_permalink":"https://app.daily.dev/posts/why-vs-code-is-still-my-go-to-ide-after-trying-everything-else--axqtxt6tn","summary":"A developer shares why Visual Studio Code remains their preferred IDE despite trying alternatives like Cursor, Trae, and browser-based editors. Key reasons include its stability, massive extension ecosystem, seamless GitHub integration, optional AI support via GitHub Copilot, and its value for developer growth. The post also recommends VS Code for beginners as a stable, flexible starting point.","image":"https://media.daily.dev/image/upload/s--VNtBj-Kt--/f_auto/v1774644736/posts/LqsQsyQxa?_a=BAMAMiWQ0","num_upvotes":3,"num_comments":4,"created_at":"2026-03-28T19:20:48.705Z"},{"id":"5K4m48b3P","title":"Squads Using Copilot? Read This Before Your Next Release","url":"","comments_permalink":"https://app.daily.dev/posts/squads-using-copilot-read-this-before-your-next-release-5k4m48b3p","summary":"AI coding assistants like GitHub Copilot can introduce security risks by generating code and modifying CI/CD pipelines before security tools scan them. Traditional SAST and SCA tools may miss workflow-level vulnerabilities, malicious dependencies, or problematic prompts that get incorporated into builds. Teams using AI-assisted development need strategies to maintain both velocity and security throughout their development pipeline.","image":"https://media.daily.dev/image/upload/s--qPpnpf_f--/f_auto/v1771327688/posts/KBadLqxhK?_a=BAMAMiiu0","num_upvotes":2,"num_comments":0,"created_at":"2026-02-17T11:29:57.879Z"},{"id":"3MIjYFDRG","title":"When One Line of Code Works Everywhere - Except Behind CloudFront","url":"","comments_permalink":"https://app.daily.dev/posts/when-one-line-of-code-works-everywhere---except-behind-cloudfront-3mijyfdrg","summary":"A production Next.js app worked identically on two AWS deployments but broke on a third when CloudFront was added. The CDN stripped React Server Components headers (RSC: 1), causing router.replace() to trigger full page reloads instead of lightweight updates, destroying Redux state mid-API-call. The fix decoupled navigation from API calls by moving logic to Redux thunks and using window.history.replaceState() instead of Next.js router methods. The incident reveals how CDNs and proxies can silently break framework protocols that depend on specific HTTP headers passing through infrastructure layers.","image":"https://media.daily.dev/image/upload/s--MKop6eh1--/f_auto/v1771221112/posts/078GOe7RD?_a=BAMAMiiu0","num_upvotes":2,"num_comments":0,"created_at":"2026-02-16T08:59:52.327Z"},{"id":"qB6hUKhrr","title":"If You Disagree, Let\u2019s Talk, But Stop Defaulting to \u2018AI-Generated\u2019","url":"","comments_permalink":"https://app.daily.dev/posts/if-you-disagree-let-s-talk-but-stop-defaulting-to-ai-generated--qb6hukhrr","summary":"The author challenges the developer community's tendency to dismiss newer developers' content as AI-generated rather than engaging with the ideas presented. They argue that learning with AI tools is the current reality for new developers, just as senior developers learned without them. The piece calls for constructive criticism and genuine conversation instead of automatic dismissal based on assumptions about AI usage.","image":"https://media.daily.dev/image/upload/s--hCZfyLfl--/f_auto/v1770867738/posts/TIJYEnybU?_a=BAMAMiiu0","num_upvotes":3,"num_comments":0,"created_at":"2026-02-12T06:00:24.818Z"},{"id":"mSVtpAg2d","title":"Rebuilding My Personal Business Hub with Astro + Custom Lead Capture","url":"","comments_permalink":"https://app.daily.dev/posts/rebuilding-my-personal-business-hub-with-astro-custom-lead-capture-msvtpag2d","summary":"A developer is rebuilding their business website using Astro for the frontend and a custom MySQL database for lead capture, hosted on a VPS with GitHub-based deployments. The project aims to create a fast, lightweight site serving as a personal brand hub, client acquisition funnel, and experimentation playground for AI and automation tools like n8n.","image":"https://media.daily.dev/image/upload/s--t_FUT2qG--/f_auto/v1769317224/posts/CAsDKgUsT?_a=BAMAMiiu0","num_upvotes":1,"num_comments":0,"created_at":"2026-01-25T15:00:20.508Z"}],"similar_handles":["dailyopensourcetools","sknexus","justjava","everythingastro","ai"],"opposite_handles":["felixrieseberg","xai","hamelhusain","hwchase17","skirano"],"similar":[{"id":"efbb7001-f465-4dca-a829-5e56b672f8b2","handle":"dailyopensourcetools","name":"Daily Open Source Tools","is_squad":true,"x":-8.2193,"y":10.0518,"cluster_id":2,"posts_collected":33,"image":"https://media.daily.dev/image/upload/s--ljDCWNBZ--/f_auto/v1731669074/squads/efbb7001-f465-4dca-a829-5e56b672f8b2","features_preview":{"posts_per_week":0.480825,"median_upvotes":4.0,"author_present_share":1.0,"hype_score":0.0,"avg_read_time":1.69697,"tag_diversity":2.424242},"top_tags_preview":[["open-source",12],["devtools",7],["webdev",4]],"view_coords":{"engagement_style":[7.0294,6.0147],"cadence_depth":[-6.3529,-8.1029],"hype_variety":[-5.0294,7.8676],"title_style":[3.3235,-4.3676]}},{"id":"9a9c19fc-3507-4006-9c8c-41dcd65df3a1","handle":"sknexus","name":"SK NEXUS","is_squad":true,"x":-8.3608,"y":10.2031,"cluster_id":2,"posts_collected":56,"image":"https://media.daily.dev/image/upload/s