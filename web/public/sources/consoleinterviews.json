{"version":"1","id":"consoleinterviews","handle":"consoleinterviews","name":"Console Interviews","image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/b995a5f7f9f04a729d0d802c3cfe23a1","description":null,"is_squad":false,"x":-0.0875,"y":-0.9228,"cluster_id":3,"posts_collected":49,"newest_post_at":"2023-05-31T10:19:47.000Z","oldest_post_at":"2021-10-12T12:00:00.000Z","features":{"hype_score":0.0,"listicle_ratio":0.0,"question_ratio":0.0,"avg_read_time":8.061224,"summary_length_avg":305.836735,"title_length_avg":38.020408,"title_length_var":19.734277,"tag_entropy":3.395019,"tag_diversity":1.081633,"top_tag_share":0.0,"avg_upvotes":3.285714,"median_upvotes":0.0,"avg_comments":0.44898,"comment_to_upvote_ratio":0.141975,"zero_engagement_share":0.55102,"viral_share":0.0,"posts_per_week":0.576843,"non_article_ratio":0.0,"author_present_share":0.0,"recency_skew":0.088889},"view_coords":{"engagement_style":[2.3235,9.1176],"cadence_depth":[-4.5294,4.1765],"hype_variety":[-8.8088,2.2941],"title_style":[-8.7647,-8.1029]},"top_tags":[["interview",21],["general-programming",18],["open-source",7],["tools",6],["cloud",4],["community",3],["rust",3],["golang",3]],"sample_titles":{"representative":["Interview with Yuval Hazaz, Amplication","Interview with Ido Shamun, Daily.dev","Interview with Omer Rosenbaum, Swimm"],"outlier":["Interview with Martin McKeaveney, Co-Founder, Budibase"]},"recent_posts":[{"id":"io1nd8sfN","title":"Interview with Yuval Hazaz, Amplication","url":"https://console.dev/interviews/amplication-yuval-hazaz","comments_permalink":"https://app.daily.dev/posts/interview-with-yuval-hazaz-amplication-io1nd8sfn","summary":"Amplication is an open source platform that allows developers to automatically generate all the repetitive and boilerplate part of their backend code. The developer gets all their code from Amplication with a Git pull request. This allows them to build scaffolding for an entire fully functional backend with all the data models, crowd operation, and even a client application.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/7bba1a3d33b96ef0c700b5a0a1f1a85f?_a=AQADKdt","num_upvotes":67,"num_comments":4,"created_at":"2023-05-31T10:19:47.000Z"},{"id":"BhjlU9FOC","title":"Interview with Cara Borenstein, CEO at Stashpad","url":"https://console.dev/interviews/stashpad-cara-borenstein","comments_permalink":"https://app.daily.dev/posts/interview-with-cara-borenstein-ceo-at-stashpad-bhjlu9foc","summary":"Stashpad is a notepad that lets developers jump across different threads and jot things down, compartmentalized, such that you never get too disorganized and always feel good about where you're at. It has code block support with lots of different languages, code syntax highlighting, all those things that you expect as a developer.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/7bba1a3d33b96ef0c700b5a0a1f1a85f?_a=AQADKdt","num_upvotes":2,"num_comments":2,"created_at":"2023-05-30T06:17:17.000Z"},{"id":"3tgZGmExo","title":"Interview with Cara Borenstein, Stashpad","url":"https://console.dev/interviews/stashpad-cara-borenstein/","comments_permalink":"https://app.daily.dev/posts/interview-with-cara-borenstein-stashpad-3tgzgmexo","summary":"Stashpad is a notepad for developers. It has all the features that developers would expect of any tool. It has code block support with lots of different languages, code syntax highlighting, all those things that you expect as a developer. The notepad is better than just a text editor in two ways.","image":"https://console.dev/img/interviews/stashpad-cara-borenstein-desk.jpg","num_upvotes":0,"num_comments":0,"created_at":"2023-04-03T12:00:00.000Z"},{"id":"69dPq7e2d","title":"Interview with Patrick Teague, Dodgeball","url":"https://console.dev/interviews/dodgeball-patrick-teague/","comments_permalink":"https://app.daily.dev/posts/interview-with-patrick-teague-dodgeball-69dpq7e2d","summary":"Dodgeball is a single integration for managing fraud and malicious user behavior on any application. You can integrate it into your application in 5 minutes, it\u2019s free for startups, and well-documented. Dodgeball protects applications by tracking visitors and by executing checkpoints at key moments of risk.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/804980a14d51a9be3d9a428d6b18b929","num_upvotes":1,"num_comments":0,"created_at":"2023-02-16T12:00:00.000Z"},{"id":"z78BRGpK1","title":"Interview with Ander Steele, Tonic","url":"https://console.dev/interviews/tonic-ander-steel/","comments_permalink":"https://app.daily.dev/posts/interview-with-ander-steele-tonic-z78brgpk1","summary":"Tonic.ai provides fake data to developers and QA can test their application code against safe, de-identified versions of their application database. The tool takes these views and builds generative models that are capable of producing synthetic data. Synthetic data can be used in place of real data to train machine-learning models, build dashboards.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/b1c09a19d1a38141165391d8cf4f562e","num_upvotes":0,"num_comments":0,"created_at":"2023-02-15T12:00:00.000Z"},{"id":"TDlYlP1eS","title":"Interview with Gilad Navot, Swimm","url":"https://console.dev/interviews/swimm-gilad-navot/","comments_permalink":"https://app.daily.dev/posts/interview-with-gilad-navot-swimm-tdlylp1es","summary":"The core of Swimm is to enable you to add live code like snippets, tokens, file paths, etc., to documents within your repository. If you integrate Swimm into your CI, we check every PR and see if you\u2019ve broken any documentation. Updating non-meaningful changes is also important.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/ee9fbf99dcb974d03fb9c9c33c765fa8","num_upvotes":1,"num_comments":0,"created_at":"2023-01-16T12:00:00.000Z"},{"id":"ECgDYe9Wj","title":"Interview with Ryan Duffield, Metrist","url":"https://console.dev/interviews/metrist-ryan-duffield/","comments_permalink":"https://app.daily.dev/posts/interview-with-ryan-duffield-metrist-ecgdye9wj","summary":"Ryan Duffield Console Interview with Ryan Duffield CTO, Metrist - Monitor your cloud dependencies. Metrist empowers people to monitor the services that they rely on. We put the health of all of your third party cloud dependencies into a single dashboard. The team structure around Metrist is a 100% remote distributed team.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/1dd12e165c6ab61a2a0da609a8b844b8","num_upvotes":0,"num_comments":0,"created_at":"2022-11-21T12:00:00.000Z"},{"id":"bcpOJxyCX","title":"Interview with Arjun Iyer, CEO, Signadot","url":"https://console.dev/interviews/signadot-arjun-iyer/","comments_permalink":"https://app.daily.dev/posts/interview-with-arjun-iyer-ceo-signadot-bcpojxycx","summary":"Signadot is a new way of thinking about test environments for microservices. We enable lightweight test environments in Kubernetes called sandboxes. We enable multi-tenancy at the application layer, instead of using the traditional model of duplicating everything at the infrastructure layer.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/63131cbe02b94c4dde6f8a57fd284faa","num_upvotes":1,"num_comments":0,"created_at":"2022-10-07T12:00:00.000Z"},{"id":"5i5kBVD49","title":"Interview with Olivier Gaudin, SonarSource","url":"https://console.dev/interviews/sonarsource-olivier-gaudin/","comments_permalink":"https://app.daily.dev/posts/interview-with-olivier-gaudin-sonarsource-5i5kbvd49","summary":"SonarSource was created 14 years ago by three partners - myself and two friends. Olivier Gaudin is the founder of the company, which has almost 400 people now. For a very long time, we have not introduced any glue functions - all the functions that you add because you start to see friction where two teams cannot work together.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/2808a42e5dc6f56e1ae83fbff1acc1ed","num_upvotes":0,"num_comments":0,"created_at":"2022-09-29T12:00:00.000Z"},{"id":"HR22P8HRF","title":"Interview with Adam Berman, Semgrep","url":"https://console.dev/interviews/semgrep-adam-berman/","comments_permalink":"https://app.daily.dev/posts/interview-with-adam-berman-semgrep-hr22p8hrf","summary":"Semgrep is a code scanning tool that can work on a number of different languages. It scans for lock files, sees what vulnerabilities you have in your packages, and then it scans your code to determine if you\u2019re using the packages in a vulnerable way. The community of security engineers has been really forthcoming with the problems they\u2019s facing and helping us see whether we can solve it.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/a86e80edd68214e04bda335580cf6e81","num_upvotes":6,"num_comments":1,"created_at":"2022-09-29T12:00:00.000Z"}],"similar_handles":["figma","wttj","djangonews","flink","allthingsopen"],"opposite_handles":["dailydevworld","on_leuwcq","horde","watercooler","dotnetsquad"],"similar":[{"id":"figma","handle":"figma","name":"Figma","is_squad":false,"x":-0.167,"y":-0.9812,"cluster_id":3,"posts_collected":300,"image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/d81fd85ddaea4d25a658694de448118f","features_preview":{"posts_per_week":2.139994,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.005,"avg_read_time":6.786667,"tag_diversity":0.453333},"top_tags_preview":[["figma",218],["ai",84],["ux",58]],"view_coords":{"engagement_style":[-0.7353,-3.0147],"cadence_depth":[5.2059,1.8676],"hype_variety":[-1.4265,2.7647],"title_style":[5.3382,5.2647]}},{"id":"wttj","handle":"wttj","name":"Welcome Tech","is_squad":false,"x":0.04,"y":-1.1046,"cluster_id":3,"posts_collected":15,"image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/bfb452503bee4bddb0675738c86d23e8","features_preview":{"posts_per_week":0.183176,"median_upvotes":0.0,"author_present_share":0.0,"hyp