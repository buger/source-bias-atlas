{"version":"1","id":"docusaurus","handle":"docusaurus","name":"Docusaurus","image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/5f3722c0b00a4f58a4d509e26dc22e53","description":null,"is_squad":false,"x":-3.3875,"y":-1.5694,"cluster_id":3,"posts_collected":26,"newest_post_at":"2026-04-07T00:00:00.000Z","oldest_post_at":"2017-12-14T00:00:00.000Z","features":{"hype_score":0.019231,"listicle_ratio":0.0,"question_ratio":0.0,"avg_read_time":4.346154,"summary_length_avg":339.192308,"title_length_avg":19.576923,"title_length_var":80.936391,"tag_entropy":2.006249,"tag_diversity":0.615385,"top_tag_share":0.192308,"avg_upvotes":15.423077,"median_upvotes":0.0,"avg_comments":0.769231,"comment_to_upvote_ratio":0.052239,"zero_engagement_share":0.615385,"viral_share":0.038462,"posts_per_week":0.225433,"non_article_ratio":0.0,"author_present_share":0.0,"recency_skew":0.04},"view_coords":{"engagement_style":[8.1029,4.3235],"cadence_depth":[-7.3971,-3.8235],"hype_variety":[4.5588,-8.7794],"title_style":[-8.3824,-7.4265]},"top_tags":[["docusaurus",25],["webdev",16],["react",7],["markdown",3],["algolia",2],["performance",2],["open-source",2],["typescript",2]],"sample_titles":{"representative":["Docusaurus 3.9","Docusaurus 3.8","Docusaurus 3.5"],"outlier":["How I Converted Profilo to Docusaurus in Under 2 Hours"]},"recent_posts":[{"id":"jJ6FZ3fB4","title":"Docusaurus 3.10","url":"https://docusaurus.io/blog/releases/3.10","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-10-jj6fz3fb4","summary":"Docusaurus 3.10 is released with several notable improvements. Docusaurus Faster (Rspack, SWC, LightningCSS) is now marked stable and will be enabled by default in v4. The release introduces a new experimental VCS API with an eager Git strategy that significantly improves build performance for large sites. Supply chain security is a major focus, with npm Trusted Publishing adopted for releases and a new daily security workflow using Socket Firewall and pnpm security settings. Strict MDX mode is being encouraged, with new v4 future flags to disable MDX v1 compatibility options and migrate to native MDX syntax for headings, admonitions, and comments. The Site Storage API is now stable with automatic localStorage key namespacing. Other changes include React 19 upgrade, TypeScript 6.0 for new sites, Algolia DocSearch 4.x compatibility, and various component improvements.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/df9a88194e1e34e4be3b28f1830c2080?_a=AQAEuop","num_upvotes":9,"num_comments":0,"created_at":"2026-04-07T00:00:00.000Z"},{"id":"DeQtFIfry","title":"Docusaurus 3.9","url":"https://docusaurus.io/blog/releases/3.9","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-9-deqtfifry","summary":"Docusaurus 3.9 drops Node.js 18 support and requires Node.js 20+, adds Algolia DocSearch v4 with AI-powered search assistant, improves internationalization with new locale configuration options, introduces Mermaid ELK layout support for complex diagrams, and includes various performance improvements and bug fixes.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/0ef81ef4131f5e4950eada76dd762255?_a=AQAEulh","num_upvotes":127,"num_comments":8,"created_at":"2025-09-25T00:00:00.000Z"},{"id":"EJqJ6mBbz","title":"Docusaurus 3.8","url":"https://docusaurus.io/blog/releases/3.8","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-8-ejqj6mbbz","summary":"Docusaurus 3.8 introduces performance improvements, including the use of Rspack persistent cache and Node.js Worker Threads, enhancing build speeds significantly. This update also includes Future Flags to prepare for upcoming changes in Docusaurus 4, along with several optimizations to reduce build times and memory usage. Additionally, there's a refactor of code block components and improved translations for various languages. Maintenance updates support Node.js 24 and TypeScript 5.8, while some unmaintained npm packages have been internalized or removed.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/4db5d5512647694306784ac16b8d25bb?_a=AQAEuj9","num_upvotes":89,"num_comments":3,"created_at":"2025-05-26T00:00:00.000Z"},{"id":"9O8KxjBTt","title":"Docusaurus 3.7","url":"https://docusaurus.io/blog/releases/3.7","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-7-9o8kxjbtt","summary":"Docusaurus 3.7 has been released with support for React 19, allowing new sites to run on React 19 by default while still maintaining compatibility with React 18. The update also includes built-in support for the SVGR plugin, new social platform icons for blog authors, improved theme translations, and various other enhancements and fixes.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/e8d252056ec4e6d1353abc3f47511b7c?_a=AQAEuj9","num_upvotes":12,"num_comments":0,"created_at":"2025-01-03T00:00:00.000Z"},{"id":"bfwNTs541","title":"Docusaurus 3.6","url":"https://docusaurus.io/blog/releases/3.6","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-6-bfwnts541","summary":"Docusaurus 3.6 enhances site build performance through the Docusaurus Faster project, incorporating Rust-based tools like Rspack, SWC, and Lightning CSS, resulting in up to 4 times faster build times and reduced memory consumption. The update is opt-in and compatible with existing plugins, allowing gradual adoption without breaking changes. Additional updates include relaxed dependencies for Mermaid diagrams, theme translations improvements, and updates for better SEO and localization support.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/0a39876c63d5aa7d9c8f254039224b27?_a=AQAEuj9","num_upvotes":5,"num_comments":0,"created_at":"2024-11-04T00:00:00.000Z"},{"id":"W7ddB7ZTf","title":"Docusaurus 3.5","url":"https://docusaurus.io/blog/releases/3.5","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-5-w7ddb7ztf","summary":"Docusaurus 3.5 introduces several new features and improvements for blogging. This includes adding social icons for blog authors, creating dedicated author pages, and enhancing blog feed styling with custom XSLT files. Additionally, new options for blog consistency practices and sidebar grouping by year are now available. The release also includes multiple translation updates and various other enhancements.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/59dc2c4cd152ede867f4053f676f5842?_a=AQAEuiZ","num_upvotes":58,"num_comments":2,"created_at":"2024-08-09T00:00:00.000Z"},{"id":"oo4c7dv5M","title":"Docusaurus 3.4","url":"https://docusaurus.io/blog/releases/3.4","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-4-oo4c7dv5m","summary":"Docusaurus 3.4 has been released with highlights including tags files, experimental hash router, and experimental site storage.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/cbdf9aada23021a8dfd3d732dbf47637?_a=AQAEuiZ","num_upvotes":19,"num_comments":2,"created_at":"2024-05-31T00:00:00.000Z"},{"id":"xtJBIG2ct","title":"Docusaurus 3.3","url":"https://docusaurus.io/blog/releases/3.3","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-3-xtjbig2ct","summary":"Docusaurus 3.3 has been released with highlights including preparation for React 19, fixing warnings for React 18.3, and improvements to the pages plugin.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/df575942264c489d1d5ff4a7e5dbcd28?_a=AQAEuiZ","num_upvotes":26,"num_comments":1,"created_at":"2024-05-03T00:00:00.000Z"},{"id":"y0SgBnubE","title":"Docusaurus 3.2","url":"https://docusaurus.io/blog/releases/3.2","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-2-y0sgbnube","summary":"Docusaurus 3.2 brings faster builds and improved dev server performance. It also introduces new features and improvements for the blog plugin and the sitemap plugin.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/2804903fb30438ae8239486e1a8a2431?_a=AQAEufR","num_upvotes":43,"num_comments":4,"created_at":"2024-03-29T00:00:00.000Z"},{"id":"4DN3QIydb","title":"Docusaurus 3.1","url":"https://docusaurus.io/blog/releases/3.1","comments_permalink":"https://app.daily.dev/posts/docusaurus-3-1-4dn3qiydb","summary":"Docusaurus 3.1 has been released with improvements to the broken links checker and a new parseFrontMatter hook.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/1f61e25a48f027b67b065fa708c8c7e7?_a=AQAEufR","num_upvotes":13,"num_comments":0,"created_at":"2024-01-05T00:00:00.000Z"}],"similar_handles":["tenderlove","abinoda","avanderlee","benkuhn","arasp"],"opposite_handles":["tbpn","alexfinn","felixrieseberg","ryolu_","kloss_xyz"],"similar":[{"id":"tenderlove","handle":"tenderlove","name":"Tenderlove Making","is_squad":false,"x":-3.3574,"y":-1.4691,"cluster_id":3,"posts_collected":13,"image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/87e9008633884d539ab3b48a87c53613","features_preview":{"posts_per_week":0.073028,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.0,"avg_read_time":5.461538,"tag_diversity":1.0},"top_tags_preview":[["ruby",8],["performance",3],["hardware",2]],"view_coords":{"engagement_style":[-1.1765,3.7941],"cadence_depth":[-9.1765,-1.0882],"hype_variety":[-4.6029,-8.1912],"title_style":[7.8971,-1.5147]}},{"id":"abinoda","handle":"abinoda","name":"Software Engineering Research","is_squad":false,"x":-3.5424,"y":-1.3302,"cluster_id":3,"posts_collected":102,"image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/70072ba716944ea6b33b3e3dc413140c","features_preview":{"posts_per_week":0.623089,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.0,"avg_read_time":4.245098,"tag_diversity":0.490196},"top_tags_preview":[["productivity",70],["ai",26],["devops",16]],"view_coords":{"engagement_style":[0.5441,2.7647],"cadence_depth":[-0.0441,-4.0882],"hype_variety":[-9.8971,-2.9559],"title_style":[7.9559