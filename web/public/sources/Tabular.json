{"version":"1","id":"Tabular","handle":"Tabular","name":"Tabular","image":"https://media.daily.dev/image/upload/s--L0JR8BCj--/f_auto/v1716188047/logos/Tabular","description":null,"is_squad":false,"x":-0.9287,"y":-4.3139,"cluster_id":3,"posts_collected":17,"newest_post_at":"2024-06-04T16:02:15.000Z","oldest_post_at":"2023-11-08T21:59:19.000Z","features":{"hype_score":0.0,"listicle_ratio":0.0,"question_ratio":0.0,"avg_read_time":3.352941,"summary_length_avg":252.823529,"title_length_avg":55.647059,"title_length_var":273.875433,"tag_entropy":2.56119,"tag_diversity":1.235294,"top_tag_share":0.0,"avg_upvotes":0.235294,"median_upvotes":0.0,"avg_comments":0.0,"comment_to_upvote_ratio":0.2,"zero_engagement_share":0.882353,"viral_share":0.0,"posts_per_week":7.735562,"non_article_ratio":0.0,"author_present_share":0.0,"recency_skew":17.0},"view_coords":{"engagement_style":[-7.4559,-9.6765],"cadence_depth":[-8.6912,-6.0735],"hype_variety":[-9.7059,-5.9853],"title_style":[-9.5441,-8.9265]},"top_tags":[["apache-iceberg",15],["java",4],["kafka",3],["big-data",3],["change-data-capture",2],["encryption",2],["aws",2],["architecture",2]],"sample_titles":{"representative":["Using Apache Iceberg views for lower latency on CDC data \u2013 Tabular","Tabular is joining Databricks \u2013 Tabular","Summing up the 1st Iceberg Summit \u2013 Tabular"],"outlier":["Tabular-on-AWS, an architecture for secure universal analytics and AI, built on Apache Iceberg \u2013 Tabular"]},"recent_posts":[{"id":"dxF3JhLXQ","title":"Tabular is joining Databricks \u2013 Tabular","url":"https://tabular.io/blog/tabular-is-joining-databricks/","comments_permalink":"https://app.daily.dev/posts/tabular-is-joining-databricks-tabular-dxf3jhlxq","summary":"Tabular has signed an agreement to join Databricks, creating a win for the market and securing the future of open table formats in enterprise data architecture. The collaboration aims to eliminate the need for choosing between table formats and improve interoperability.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/d569ca06bf8c03a958eace2b82de82f7?_a=AQAEuiZ","num_upvotes":1,"num_comments":0,"created_at":"2024-06-04T16:02:15.000Z"},{"id":"E5qS8PnM3","title":"Summing up the 1st Iceberg Summit \u2013 Tabular","url":"https://tabular.io/blog/summing-up-the-1st-iceberg-summit/","comments_permalink":"https://app.daily.dev/posts/summing-up-the-1st-iceberg-summit-tabular-e5qs8pnm3","summary":"The 1st Iceberg Summit was a success with 2,271 attendees and a 69% attendance rate. The top talk was the Opening Keynote by Tabular CEO. Some popular sessions included Leveraging Iceberg Puffin Files, Historical Data Archive at Bloomberg, and Toward Optimizing EB Iceberg Lakes.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/bb7f55996bd8186b774c1c66bb44bd38?_a=AQAEuiZ","num_upvotes":0,"num_comments":0,"created_at":"2024-05-20T23:41:17.000Z"},{"id":"YPRGx53SM","title":"Using Apache Iceberg views for lower latency on CDC data \u2013 Tabular","url":"https://tabular.io/blog/using-apache-iceberg-views-for-lower-latency-on-cdc-data/","comments_permalink":"https://app.daily.dev/posts/using-apache-iceberg-views-for-lower-latency-on-cdc-data-tabular-yprgx53sm","summary":"Streaming ingestion into Apache Iceberg tables brings real-time and batch closer together. Trade-offs must be considered when using CDC data in Iceberg tables. By using a view that combines data from the change log table and mirror table, users can achieve low latency and query fresher customer data in their data lake.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/1a06d9fe0cfb4ef491052bfad45204bb?_a=AQAEuiZ","num_upvotes":3,"num_comments":0,"created_at":"2024-05-06T23:03:09.000Z"},{"id":"BOZ4k7ne7","title":"March 2024 \u2013 Iceberg Community News \u2013 Tabular","url":"https://tabular.io/blog/march-2024-iceberg-community-news/","comments_permalink":"https://app.daily.dev/posts/march-2024-iceberg-community-news-tabular-boz4k7ne7","summary":"March 2024 Iceberg Community News highlights the Iceberg Summit, new committers, updates on Iceberg Java and other resources related to Apache Iceberg.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/d5ebcc839def17399d8d33cae8883003?_a=AQAEuiZ","num_upvotes":0,"num_comments":0,"created_at":"2024-04-04T00:12:38.000Z"},{"id":"f3LF0EOMo","title":"Iceberg News at Kafka Summit London 2024 \u2013 Tabular","url":"https://tabular.io/blog/iceberg-news-at-kafka-summit-london-2024/","comments_permalink":"https://app.daily.dev/posts/iceberg-news-at-kafka-summit-london-2024-tabular-f3lf0eomo","summary":"The Kafka Summit in London featured a presentation on streaming Kafka events into Apache Iceberg. Tableflow, a new service from Confluent, automatically turns data in Kafka topics into Iceberg tables. More information about Tableflow can be found in a post by Confluent staff product manager Marc Selwan.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/1a06d9fe0cfb4ef491052bfad45204bb?_a=AQAEuiZ","num_upvotes":0,"num_comments":0,"created_at":"2024-03-27T22:07:35.000Z"},{"id":"VRmSqzMm2","title":"Graph queries on Apache Iceberg tables \u2013 Tabular","url":"https://tabular.io/blog/graph-queries-on-apache-iceberg-tables/","comments_permalink":"https://app.daily.dev/posts/graph-queries-on-apache-iceberg-tables-tabular-vrmsqzmm2","summary":"Graph databases face challenges in scaling and data duplication. PuppyGraph and Apache Iceberg provide solutions for efficient graph traversal.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/22459a7c913e451caf822cb7974b866c?_a=AQAEuiZ","num_upvotes":0,"num_comments":0,"created_at":"2024-03-14T15:52:43.000Z"},{"id":"dkwJGpPEF","title":"Mirroring data (CDC) in Apache Iceberg with Debezium and Kafka Connect \u2013 Tabular","url":"https://tabular.io/blog/mirroring-data-cdc-in-apache-iceberg-with-debezium-and-kafka-connect/","comments_permalink":"https://app.daily.dev/posts/mirroring-data-cdc-in-apache-iceberg-with-debezium-and-kafka-connect-tabular-dkwjgppef","summary":"This post discusses the use of Debezium and Kafka Connect to mirror operational database tables in Apache Iceberg. It explains the challenges of streaming ingestion and the benefits of maintaining a change log table. It also provides instructions on loading data from a Kafka topic, creating a mirror table, and performing a merge query.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/df990a453a24654442df8d0690e11561?_a=AQAEuiZ","num_upvotes":0,"num_comments":0,"created_at":"2024-03-13T16:39:00.000Z"},{"id":"XF4a813pH","title":"February 2024: Iceberg Community News \u2013 Tabular","url":"https://tabular.io/blog/february-2024-iceberg-community-news/","comments_permalink":"https://app.daily.dev/posts/february-2024-iceberg-community-news-tabular-xf4a813ph","summary":"February 2024: Iceberg Community News - Tabular newsletter revisiting updates to Apache Iceberg, including Java and PyIceberg. Announcement of Iceberg Summit 2024. Blogs, podcasts, videos, ecosystem updates, and vendor updates also mentioned.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/f4325ce2f610eb714e3bf734170ee97a?_a=AQAEuiZ","num_upvotes":0,"num_comments":0,"created_at":"2024-03-05T21:34:43.000Z"},{"id":"pWadsWVXY","title":"Announcing the first Iceberg Summit \u2013 Tabular","url":"https://tabular.io/blog/announcing-first-iceberg-summit/","comments_permalink":"https://app.daily.dev/posts/announcing-the-first-iceberg-summit-tabular-pwadswvxy","summary":"Iceberg Summit is a virtual event organized by Tabular and Dremio in collaboration with the Apache Iceberg PMC. It will feature technical talks on various topics related to Iceberg, including integration, data modeling, security, and more. The event will be held on May 14 - 15, 2024.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/b137e7455c9b2f99ea388c438188a982?_a=AQAEuiZ","num_upvotes":0,"num_comments":0,"created_at":"2024-03-05T14:58:26.000Z"},{"id":"o42xXJlE2","title":"PyIceberg 0.6.0: Write support \u2013 Tabular","url":"https://tabular.io/blog/pyiceberg-0-6-0-write-support/","comments_permalink":"https://app.daily.dev/posts/pyiceberg-0-6-0-write-support-tabular-o42xxjle2","summary":"PyIceberg 0.6.0 introduces write support, allowing users to write to an Iceberg table from Python. Other new features include commit support for Glue, SQL, and Hive catalogs, name mapping for Parquet files, and the ability to construct Avro writer trees. The roadmap for future PyIceberg releases includes adding support for writing to partitioned tables, partial overwrites, merge into/upsert operations, and compaction.","image":"https://media.daily.dev/image/upload/f_auto,q_auto/v1/posts/de874f93f1e8ec0362a25ef7d8d69e0a?_a=AQAEuiZ","num_upvotes":0,"num_comments":0,"created_at":"2024-02-20T12:55:11.000Z"}],"similar_handles":["rbloggers","backstage","meta_ai","pythonawe","linuxfoundation"],"opposite_handles":["dailydevworld","horde","on_leuwcq","watercooler","dotnetsquad"],"similar":[{"id":"rbloggers","handle":"rbloggers","name":"R-bloggers","is_squad":false,"x":-1.043,"y":-4.324,"cluster_id":3,"posts_collected":635,"image":"https://media.daily.dev/image/upload/t_logo,f_auto/v1/logos/98bcbbdf72774292a55ceda8f2277f1e","features_preview":{"posts_per_week":2.546694,"median_upvotes":0.0,"author_present_share":0.0,"hype_score":0.012598,"avg_read_time":7.009449,"tag_diversity":0.349606},"top_tags_preview":[["r",538],["data-science",209],["machine-learning",111]],"view_coords":{"engagement_style":[-6.3971,-5.3235],"cadence_depth":[9.3235,2.3088],"hype_variety":[2.4853,4.5294],"title_style":[3.1618,2.2206]}},{"id":"backstage","handle":"backstage","name":"Backstage","is_squad":false,"x":-1.0235,"y":-4.1132,"cluster_id":3,"posts_collected":27,"image":"https://media.daily.dev/image/upload/s--yGImq3oJ--/f_auto/v1743317677/logos/backstage","features_preview":{"posts_per_wee